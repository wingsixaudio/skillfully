{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skillfully:contract:1:messages",
  "title": "Skillfully plugin messages, contract 1",
  "description": "Every message that may cross between the hub and a plugin. Each is one JSON object with a type.",
  "$defs": {
    "key": {
      "description": "The name of one value: a capability, then the value's name within it, for example console/input/3/bus/5/level. Names come from the capability's definition, never from a vendor.",
      "type": "string",
      "maxLength": 120,
      "pattern": "^[a-z][a-z0-9-]*(/[A-Za-z0-9_][A-Za-z0-9_.-]*){1,9}$"
    },
    "value": { "type": ["number", "string", "boolean"] },
    "values": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/key" },
      "additionalProperties": { "$ref": "#/$defs/value" }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "unknown_key",
            "out_of_range",
            "read_only",
            "invalid",
            "device_unreachable",
            "timeout",
            "internal"
          ]
        },
        "message": { "type": "string", "maxLength": 300 }
      }
    },

    "hello": {
      "description": "Plugin to hub. Always the first message.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "contract", "id", "version", "token"],
      "properties": {
        "type": { "const": "hello" },
        "contract": { "const": "1" },
        "id": { "type": "string" },
        "version": { "type": "string" },
        "token": { "description": "The one-time token the hub gave this process at start.", "type": "string" }
      }
    },
    "state": {
      "description": "Plugin to hub. What the device says is true. full means every value the plugin knows; otherwise only what changed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "full", "values"],
      "properties": {
        "type": { "const": "state" },
        "full": { "type": "boolean" },
        "values": { "$ref": "#/$defs/values" }
      }
    },
    "event": {
      "description": "Plugin to hub. Something happened that is not a value, such as the device connecting.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name"],
      "properties": {
        "type": { "const": "event" },
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)*$", "maxLength": 80 },
        "data": { "type": "object" }
      }
    },
    "result": {
      "description": "Plugin to hub. The answer to one command. Every value the command set appears exactly once: in values with what the device read back, or in errors.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "values", "errors"],
      "properties": {
        "type": { "const": "result" },
        "id": { "type": "string" },
        "values": { "$ref": "#/$defs/values" },
        "errors": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/key" },
          "additionalProperties": { "$ref": "#/$defs/error" }
        }
      }
    },
    "health": {
      "description": "Plugin to hub. Sent after the welcome, on every change, and at least every 5 seconds.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "status"],
      "properties": {
        "type": { "const": "health" },
        "status": { "enum": ["ok", "degraded", "down"] },
        "reason": { "type": "string", "maxLength": 300 }
      }
    },

    "settings": {
      "description": "Plugin to hub. The settings this driver takes, for a driver that can only say so once it is running. The hub shows them to a superuser as a form. They are data for a person to read, never instructions.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "fields"],
      "properties": {
        "type": { "const": "settings" },
        "fields": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "kind"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 64 },
              "label": { "type": "string", "maxLength": 200 },
              "kind": {
                "description": "text, number, toggle and choice are things to fill in. secret is text that is never shown again. note is words to read, with nothing to fill in.",
                "enum": ["text", "number", "toggle", "choice", "secret", "note"]
              },
              "default": { "type": ["number", "string", "boolean"] },
              "choices": {
                "type": "array",
                "maxItems": 300,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "label"],
                  "properties": {
                    "id": { "type": ["number", "string", "boolean"] },
                    "label": { "type": "string", "maxLength": 200 }
                  }
                }
              },
              "min": { "type": "number" },
              "max": { "type": "number" },
              "help": { "type": "string", "maxLength": 1000 }
            }
          }
        }
      }
    },
    "welcome": {
      "description": "Hub to plugin. The answer to hello. Carries the plugin's settings, because a plugin stores nothing.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "contract", "mode", "settings"],
      "properties": {
        "type": { "const": "welcome" },
        "contract": { "const": "1" },
        "mode": { "enum": ["listen", "act"] },
        "settings": { "type": "object" }
      }
    },
    "command": {
      "description": "Hub to plugin. Set these values. A command always names the value wanted, never a change to it, so sending it twice is harmless.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "set"],
      "properties": {
        "type": { "const": "command" },
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "set": { "type": "object", "$ref": "#/$defs/values", "minProperties": 1 }
      }
    },
    "resync": {
      "description": "Hub to plugin. Send a full state now.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "resync" } }
    },
    "mode": {
      "description": "Hub to plugin. For information only. The hub enforces the mode itself: in listen it never sends a command.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "mode"],
      "properties": { "type": { "const": "mode" }, "mode": { "enum": ["listen", "act"] } }
    },
    "shutdown": {
      "description": "Hub to plugin. Stop within 2 seconds.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "shutdown" } }
    }
  }
}
